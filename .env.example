# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FIREBASE_PROJECT_ID: (Optional) ID del proyecto Firebase para inicializar firebase-admin
FIREBASE_PROJECT_ID="gen-lang-client-0531791519"

# FIREBASE_SERVICE_ACCOUNT: (Optional) JSON string con las credenciales de Service Account de Firebase Admin
FIREBASE_SERVICE_ACCOUNT=

# OUTDOOR_SYNC_SECRET: secreto que Cloud Scheduler manda en el header "x-cultiveta-cron-secret"
# al llamar POST /api/internal/outdoor-weather (sincronización de clima, 1 vez por hora).
# Sin este valor el endpoint responde 503. Usá un valor largo y aleatorio.
OUTDOOR_SYNC_SECRET=

# APP_TIMEZONE: zona horaria de las fechas que genera el servidor (mediciones automáticas, alertas,
# contador de IA). Por defecto: America/Argentina/Buenos_Aires.
APP_TIMEZONE="America/Argentina/Buenos_Aires"

# AI_DAILY_LIMIT: consultas a Cultiveta IA por persona y por día (por defecto 60).
AI_DAILY_LIMIT=60

# LOCAL_OUTDOOR_SYNC: solo desarrollo. Con "1" el servidor sincroniza el clima cada hora sin Cloud Scheduler.
LOCAL_OUTDOOR_SYNC=
