rules_version = '2';

// Reglas de seguridad para Firebase Storage de Cultiveta
// Restringe el acceso de usuarios a sus propias evidencias y bloquea acceso directo al catálogo de referencia
service firebase.storage {
  match /b/{bucket}/o {
    // Evidencias fotográficas y archivos del usuario autenticado
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null 
                            && request.auth.uid == userId
                            && request.resource.size < 15 * 1024 * 1024
                            && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Catálogo de fotografías oficiales de referencia de genéticas (solo accesible y mutable vía Firebase Admin en backend)
    match /genetics/reference/{allPaths=**} {
      allow read, write: if false;
    }

    // Denegación por defecto para cualquier otra ruta no autorizada
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
