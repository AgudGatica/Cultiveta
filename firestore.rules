rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile with strict privilege escalation prevention
    match /users/{userId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      // Prevent client self-assigning admin privileges on profile creation (role can only be 'user' or absent, isCreator only false or absent)
      allow create: if request.auth != null && request.auth.uid == userId
                    && (!('role' in request.resource.data) || request.resource.data.role == 'user')
                    && (!('isCreator' in request.resource.data) || request.resource.data.isCreator == false)
                    && !request.resource.data.keys().hasAny(['admin', 'creator', 'customClaims', 'permissions']);
      // Prevent client modifying RBAC/admin fields on profile update
      allow update: if request.auth != null && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isCreator', 'admin', 'creator', 'customClaims', 'permissions']);
    }
    // Subcollections under users
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Catálogo de fotografías oficiales de genéticas (solo accesible y mutable vía Firebase Admin en backend)
    match /geneticsCatalogPhotos/{docId} {
      allow read, write: if false;
    }
    // Top-level collections scoped by userId field (excluyendo expresamente colecciones reservadas)
    match /{collection}/{document} {
      function isReservedTopLevelCollection() {
        return collection == 'users'
            || collection == 'geneticsCatalogPhotos';
      }

      allow read, update, delete: if request.auth != null
        && !isReservedTopLevelCollection()
        && resource.data.userId == request.auth.uid;

      allow create: if request.auth != null
        && !isReservedTopLevelCollection()
        && request.resource.data.userId == request.auth.uid;
    }
  }
}
