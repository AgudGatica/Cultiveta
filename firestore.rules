rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Subcollections under users
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Catálogo de fotografías oficiales de genéticas (lectura por usuarios autenticados, mutación exclusiva por backend admin)
    match /geneticsCatalogPhotos/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // Top-level collections scoped by userId field
    match /{collection}/{document} {
      allow read, update, delete: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
  }
}
